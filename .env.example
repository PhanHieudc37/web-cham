# Phase 0: only these four values are needed for the local scaffold.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
SUPABASE_STORAGE_BUCKET=media

# Phase 1: real PostgreSQL/Supabase credentials; never commit .env.
# Supabase transaction pooler (6543); plain local PostgreSQL URLs also work.
DATABASE_URL=
# Supabase session pooler (5432), used for migrations.
DIRECT_URL=
# A separate database; never use the development or production database for tests.
TEST_DATABASE_URL=
SUPABASE_URL=
# Server secret key (sb_secret_...) or legacy service_role key; never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Required for production. Optional in development.
RESEND_API_KEY=
EMAIL_FROM=
SHOP_NOTIFY_EMAIL=

# Optional notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required only when seeding the first admin account in Phase 1.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Phase 14b / 14c only.
SEPAY_WEBHOOK_API_KEY=
CRON_SECRET=

# Phase 13: copy this template to .env.deploy.local and fill a SEPARATE production
# project per docs/DEPLOYMENT.md. Keep TEST_DATABASE_URL empty in that file.
# Offline admin recovery only; never add these two values to Vercel.
ADMIN_RECOVERY_EMAIL=
ADMIN_RECOVERY_PASSWORD=
