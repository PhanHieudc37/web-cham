{
  "name": "cham-stu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p preview/tsconfig.json --noEmit",
    "preview:build": "node scripts/build-preview.mjs",
    "preview:dev": "node scripts/build-preview.mjs && node scripts/serve-preview.mjs",
    "preview:test": "playwright test --config playwright.preview.config.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs studio",
    "db:auth": "node scripts/generate-auth-schema.mjs",
    "db:test:setup": "node scripts/setup-test-database.mjs",
    "db:seed": "tsx --conditions=react-server src/server/db/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
